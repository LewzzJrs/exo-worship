# Kode akses awal untuk anggota (huruf besar/kecil tidak dibedakan).
# Setelah admin mengganti kode di halaman Pengaturan, kode dari database yang berlaku.
TEAM_ACCESS_CODE=
# String acak panjang untuk menandatangani cookie akses, buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Supabase: Project URL (tombol Connect) dan secret key (Project Settings -> API Keys)
# Hanya dipakai di server, jangan diberi awalan NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Nomor WhatsApp admin untuk halaman Bantuan, format internasional tanpa + (contoh 6281234567890)
ADMIN_WHATSAPP=
# Password untuk masuk halaman admin (/admin)
ADMIN_PASSWORD=
